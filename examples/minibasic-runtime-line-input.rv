info payload
; Deux lignes source target-side, volontairement saisies dans le désordre.
data 0x82000000 .byte 0x32
data 0x82000001 .byte 0x30
data 0x82000002 .byte 0x20
data 0x82000003 .byte 0x50
data 0x82000004 .byte 0x52
data 0x82000005 .byte 0x49
data 0x82000006 .byte 0x4e
data 0x82000007 .byte 0x54
data 0x82000008 .byte 0x20
data 0x82000009 .byte 0x42
data 0x8200000a .byte 0x00
data 0x82000020 .byte 0x31
data 0x82000021 .byte 0x30
data 0x82000022 .byte 0x20
data 0x82000023 .byte 0x50
data 0x82000024 .byte 0x52
data 0x82000025 .byte 0x49
data 0x82000026 .byte 0x4e
data 0x82000027 .byte 0x54
data 0x82000028 .byte 0x20
data 0x82000029 .byte 0x41
data 0x8200002a .byte 0x00
assemble-program 0x81000100
; x6 table, x5 count, x9 source offset, x10 line, x11 length.
entry:
auipc x8,0x1000
addi x8,x8,-256
addi x6,x8,256
addi x5,x0,0
addi x9,x0,0
jal x1,parse_line
addi x5,x0,1
addi x9,x0,32
jal x1,parse_line
addi x5,x0,2
sd x5,512(x8)
ebreak
; Parse une ligne puis l’insère dans l’un des deux slots.
parse_line:
add x24,x1,x0
addi x10,x0,0
addi x11,x0,0
line_digits:
add x7,x8,x9
lbu x14,0(x7)
addi x15,x0,32
beq x14,x15,line_separator
addi x15,x0,48
sub x14,x14,x15
sltiu x15,x14,10
beq x15,x0,fail
slli x7,x10,3
slli x18,x10,1
add x10,x7,x18
add x10,x10,x14
addi x9,x9,1
jal x0,line_digits
line_separator:
addi x9,x9,1
addi x11,x0,0
addi x18,x8,512
copy_body:
add x7,x8,x9
lbu x14,0(x7)
beq x14,x0,body_done
sb x14,0(x18)
addi x9,x9,1
addi x18,x18,1
addi x11,x11,1
jal x0,copy_body
body_done:
beq x5,x0,first_slot
ld x13,0(x6)
slt x15,x10,x13
bne x15,x0,insert_before
addi x19,x6,32
sd x10,0(x19)
sd x11,8(x19)
jal x1,copy_record
jalr x0,0(x24)
insert_before:
ld x14,0(x6)
sd x14,32(x6)
ld x14,8(x6)
sd x14,40(x6)
addi x18,x6,16
addi x19,x6,48
addi x22,x0,0
move_old_body:
beq x22,x14,first_slot
lbu x23,0(x18)
sb x23,0(x19)
addi x18,x18,1
addi x19,x19,1
addi x22,x22,1
jal x0,move_old_body
first_slot:
sd x10,0(x6)
sd x11,8(x6)
addi x19,x6,16
jal x1,copy_record
jalr x0,0(x24)
; Copie le corps temporaire vers le champ body du record.
copy_record:
add x23,x1,x0
addi x18,x8,512
addi x22,x0,0
copy_record_loop:
beq x22,x11,copy_record_done
lbu x14,0(x18)
sb x14,0(x19)
addi x18,x18,1
addi x19,x19,1
addi x22,x22,1
jal x0,copy_record_loop
copy_record_done:
jalr x0,0(x23)
fail:
addi x10,x0,1
addi x17,x0,3
ecall
end
symbols
run-at 0x81000100
regs
memory 0x82000100 64
memory 0x82000200 8
q
