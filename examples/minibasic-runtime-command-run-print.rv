data 0x82000118 .byte 0x33
data 0x82000200 .dword 0x0000000000000001
assemble-program 0x81000100
; RUN minimal : le programme et le résultat restent dans la cible.
entry:
auipc x8,0x1000
addi x8,x8,-256
addi x18,x8,768
addi x9,x0,0
read_command:
addi x17,x0,2
ecall
addi x7,x0,10
beq x10,x7,command_done
add x6,x18,x9
sb x10,0(x6)
addi x9,x9,1
jal x0,read_command
command_done:
addi x6,x18,0
lbu x10,0(x6)
addi x7,x0,82
bne x10,x7,fail
lbu x10,1(x6)
addi x7,x0,85
bne x10,x7,fail
lbu x10,2(x6)
addi x7,x0,78
bne x10,x7,fail
; Vérifier PRINT 2+3 dans le premier record.
addi x6,x8,272
lbu x10,0(x6)
addi x7,x0,80
bne x10,x7,fail
lbu x10,1(x6)
addi x7,x0,82
bne x10,x7,fail
lbu x10,2(x6)
addi x7,x0,73
bne x10,x7,fail
lbu x10,3(x6)
addi x7,x0,78
bne x10,x7,fail
lbu x10,4(x6)
addi x7,x0,84
bne x10,x7,fail
lbu x10,5(x6)
addi x7,x0,32
bne x10,x7,fail
lbu x10,6(x6)
addi x10,x10,-48
lbu x11,8(x6)
addi x11,x11,-48
add x12,x10,x11
addi x12,x12,48
addi x13,x8,1024
sb x12,0(x13)
addi x14,x0,10
sb x14,1(x13)
addi x10,x13,0
addi x11,x0,2
addi x17,x0,4
ecall
addi x10,x0,0
addi x17,x0,3
ecall
fail:
