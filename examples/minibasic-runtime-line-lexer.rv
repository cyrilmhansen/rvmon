info payload
; Source target-side : "20 PRINT B" (ASCII, sans résultat codé par l’hôte).
data 0x82000000 .byte 0x32
data 0x82000001 .byte 0x30
data 0x82000002 .byte 0x20
data 0x82000003 .byte 0x50
data 0x82000004 .byte 0x52
data 0x82000005 .byte 0x49
data 0x82000006 .byte 0x4e
data 0x82000007 .byte 0x54
data 0x82000008 .byte 0x20
data 0x82000009 .byte 0x42
data 0x8200000a .byte 0x00
assemble-program 0x81000100
; x8 = source, x6 = record, x10 = numéro, x12 = longueur du corps.
entry:
auipc x8,0x1000
addi x8,x8,-256
addi x6,x8,256
addi x9,x0,0
addi x10,x0,0
; Numéro de ligne décimal jusqu’au séparateur espace.
line_digits:
add x7,x8,x9
lbu x14,0(x7)
addi x15,x0,32
beq x14,x15,line_separator
addi x15,x0,48
sub x14,x14,x15
sltiu x15,x14,10
beq x15,x0,fail
slli x7,x10,3
slli x11,x10,1
add x10,x7,x11
add x10,x10,x14
addi x9,x9,1
jal x0,line_digits
line_separator:
sd x10,0(x6)
addi x9,x9,1
addi x12,x0,0
addi x7,x6,16
; Copie du corps dans la zone fixe de l’enregistrement.
copy_body:
add x11,x8,x9
lbu x14,0(x11)
beq x14,x0,body_end
sb x14,0(x7)
addi x9,x9,1
addi x7,x7,1
addi x12,x12,1
jal x0,copy_body
body_end:
sd x12,8(x6)
addi x5,x0,1
sd x5,512(x8)
ebreak
fail:
addi x10,x0,1
addi x17,x0,3
ecall
end
symbols
run-at 0x81000100
regs
memory 0x82000100 32
memory 0x82000200 8
q
