sd x1,1648(x8)
sd x22,1656(x8)
sd x28,1664(x8)
sd x29,1680(x8)
sd x30,1808(x8)
addi x21,x21,6
addi x30,x0,1
jal x1,resolve_string_expression
sd x7,1944(x8)
sd x11,1952(x8)
lui x27,0x82060
slli x27,x27,32
srli x27,x27,32
addi x27,x27,1840
addi x9,x0,0
