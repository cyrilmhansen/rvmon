slli x7,x27,3
addi x30,x8,2047
addi x30,x30,9
add x30,x30,x7
sd x26,0(x30)
addi x27,x27,1
addi x29,x8,2047
addi x29,x29,1
sd x27,0(x29)
addi x10,x0,3
