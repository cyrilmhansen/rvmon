sd x10,568(x8)
jal x0,print_result
; WHILE/WEND et REPEAT/UNTIL utilisent des piles statiques distinctes pour
; retrouver le record de reprise et sauter les blocs faux sans récursion hôte.
while_dispatch:
lbu x5,17(x24)
addi x7,x0,72
beq x5,x7,while_statement
addi x7,x0,69
beq x5,x7,wend_statement
jal x0,assignment_statement
while_statement:
; WHILE accepte une expression numérique ou une comparaison binary64.
lbu x5,18(x24)
addi x7,x0,73
bne x5,x7,error_line_near
lbu x5,19(x24)
addi x7,x0,76
bne x5,x7,error_line_near
lbu x5,20(x24)
addi x7,x0,69
bne x5,x7,error_line_near
lbu x5,21(x24)
addi x7,x0,32
bne x5,x7,error_line_near
addi x21,x24,22
addi x22,x0,0
jal x1,eval_expression
fmv.x.d x10,f3
fmv.d.x f1,x10
fsd f1,1016(x8)
while_operator_spaces:
lbu x27,0(x21)
addi x6,x0,32
bne x27,x6,while_operator
addi x21,x21,1
jal x0,while_operator_spaces
while_operator:
beq x27,x0,while_truth_value
addi x6,x0,60
beq x27,x6,while_less
addi x6,x0,61
beq x27,x6,while_equal
addi x6,x0,62
beq x27,x6,while_greater
jal x0,error_line
while_less:
addi x21,x21,1
lbu x5,0(x21)
addi x6,x0,61
beq x5,x6,while_less_equal
addi x6,x0,62
beq x5,x6,while_not_equal
addi x22,x0,1
jal x1,eval_expression
fld f1,1016(x8)
fmv.x.d x10,f3
fmv.d.x f2,x10
flt.d x10,f1,f2
jal x0,while_condition_result
while_less_equal:
addi x21,x21,1
addi x22,x0,1
jal x1,eval_expression
fld f1,1016(x8)
fmv.x.d x10,f3
fmv.d.x f2,x10
fle.d x10,f1,f2
jal x0,while_condition_result
while_not_equal:
addi x21,x21,1
addi x22,x0,1
jal x1,eval_expression
fld f1,1016(x8)
fmv.x.d x10,f3
fmv.d.x f2,x10
feq.d x10,f1,f2
xori x10,x10,1
jal x0,while_condition_result
while_equal:
addi x21,x21,1
addi x22,x0,1
jal x1,eval_expression
fld f1,1016(x8)
fmv.x.d x10,f3
fmv.d.x f2,x10
feq.d x10,f1,f2
jal x0,while_condition_result
while_greater:
addi x21,x21,1
lbu x5,0(x21)
addi x6,x0,61
beq x5,x6,while_greater_equal
addi x22,x0,1
jal x1,eval_expression
fld f1,1016(x8)
fmv.x.d x10,f3
fmv.d.x f2,x10
flt.d x10,f2,f1
jal x0,while_condition_result
while_greater_equal:
addi x21,x21,1
addi x22,x0,1
jal x1,eval_expression
fld f1,1016(x8)
fmv.x.d x10,f3
fmv.d.x f2,x10
fle.d x10,f2,f1
jal x0,while_condition_result
while_truth_value:
fcvt.d.l f2,x0,0
fld f1,1016(x8)
feq.d x10,f1,f2
xori x10,x10,1
while_condition_result:
ld x26,1872(x8)
bne x10,x0,while_condition_true
jal x0,while_condition_false
while_condition_true:
addi x29,x8,2047
addi x29,x29,1
ld x27,0(x29)
sltiu x7,x27,8
beq x7,x0,error_line_near
beq x27,x0,while_push
addi x7,x27,-1
slli x7,x7,3
addi x30,x8,2047
addi x30,x30,9
add x30,x30,x7
ld x31,0(x30)
beq x31,x26,while_continue
