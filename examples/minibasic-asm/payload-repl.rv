addi x10,x0,1
jal x1,control_push
sd x0,568(x8)
jal x0,if_false
next_statement:
 lbu x5,17(x24)
 addi x7,x0,61
 beq x5,x7,assignment_statement
ld x27,1240(x8)
beq x27,x0,error_line_near
addi x27,x27,-1
slli x6,x27,5
addi x31,x8,1280
add x31,x31,x6
ld x7,0(x31)
addi x30,x7,0
fld f1,0(x7)
fld f2,16(x31)
fmv.x.d x10,f1
fmv.d.x f3,x10
fadd.d f4,f1,f2
fsd f4,0(x30)
fld f5,8(x31)
fcvt.d.l f7,x0,0
feq.d x10,f2,f7
bne x10,x0,error_line
flt.d x10,f2,f7
bne x10,x0,next_negative
fle.d x10,f4,f5
bne x10,x0,next_loop_flag
addi x10,x0,2
jal x0,next_loop_flag
next_negative:
fle.d x10,f5,f4
bne x10,x0,next_loop_flag
addi x10,x0,2
