error_line_near:
jal x0,error_line
; FOR/NEXT : un frame statique contient variable, limite, pas et continuation.
; Le signe du STEP choisit la comparaison terminale ; huit frames maximum.
for_statement:
 lbu x5,17(x24)
 addi x7,x0,61
 beq x5,x7,assignment_statement
ld x27,1240(x8)
sltiu x7,x27,8
beq x7,x0,error_line
addi x6,x8,2047
addi x6,x6,561
sd x27,0(x6)
slli x6,x27,5
addi x31,x8,1280
add x31,x31,x6
sd x31,1560(x8)
addi x10,x26,1
sd x10,24(x31)
addi x21,x24,20
