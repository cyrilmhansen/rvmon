addi x7,x7,48
sb x7,0(x13)
addi x13,x13,1
remu x10,x10,x6
addi x6,x0,100
divu x7,x10,x6
addi x7,x7,48
sb x7,0(x13)
addi x13,x13,1
remu x10,x10,x6
addi x6,x0,10
divu x7,x10,x6
addi x7,x7,48
sb x7,0(x13)
addi x13,x13,1
remu x10,x10,x6
addi x7,x10,48
sb x7,0(x13)
addi x13,x13,1
