; LIST : sélectionne les records non vides, reconstruit leur numéro et émet
; le corps via le service guest de sortie ; aucun texte n'est fabriqué par
; l'hôte.
; ---------------------------------------------------------------------------
; LIST / NEW / RUN
; LIST parcourt line_lengths dans l'ordre des indices et émet le record associé.
; NEW vide les longueurs et les piles ; RUN initialise current_line et délègue
; l'exécution d'une ligne à run_line.
; ---------------------------------------------------------------------------
list_line:
jal x0,list_line_generic
list_line_generic:
addi x26,x0,0
list_scan_generic:
 slli x7,x26,3
ld x12,480(x8)
 add x12,x12,x7
 ld x13,0(x12)
 beq x13,x0,list_next_generic
slli x7,x26,7
add x24,x19,x7
ld x10,0(x24)
sltiu x7,x10,100
beq x7,x0,list_three_digits
addi x13,x8,208
addi x6,x0,10
divu x7,x10,x6
addi x7,x7,48
sb x7,0(x13)
addi x13,x13,1
addi x7,x0,48
sb x7,0(x13)
addi x13,x13,1
jal x0,list_number_done
