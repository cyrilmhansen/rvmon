beq x7,x0,list_four_digits
addi x13,x8,208
addi x6,x0,100
divu x7,x10,x6
addi x7,x7,48
sb x7,0(x13)
addi x13,x13,1
remu x10,x10,x6
addi x6,x0,10
divu x7,x10,x6
addi x7,x7,48
sb x7,0(x13)
addi x13,x13,1
addi x7,x0,48
sb x7,0(x13)
addi x13,x13,1
jal x0,list_number_done
