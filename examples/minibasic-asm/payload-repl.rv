; ---------------------------------------------------------------------------
; Dispatch d'instructions BASIC
; Les mots-clés sont reconnus directement sur les octets du record. Les
; sous-dispatchers séparent expressions, chaînes et structures de contrôle ;
; cette séparation garde les conventions de curseur explicites au débogueur.
; ---------------------------------------------------------------------------
dispatch_statement:
sd x24,1864(x8)
sd x26,1872(x8)
ld x10,544(x8)
beq x10,x0,trace_done
ld x10,536(x8)
beq x10,x0,trace_ten
addi x10,x8,128
addi x11,x0,5
addi x17,x0,4
ecall
jal x0,trace_done
trace_ten:
addi x10,x8,112
addi x11,x0,5
addi x17,x0,4
ecall
trace_done:
jal x0,statement_table_probe
statement_dispatch_legacy:
lbu x10,16(x24)
addi x7,x0,71
beq x10,x7,goto_dispatch
addi x7,x0,79
bne x10,x7,dispatch_not_on
lbu x5,17(x24)
addi x7,x0,78
beq x5,x7,on_statement
jal x0,assignment_statement
dispatch_not_on:
addi x7,x0,87
bne x10,x7,dispatch_not_while
jal x0,while_dispatch
dispatch_not_while:
addi x7,x0,85
bne x10,x7,dispatch_not_until
jal x0,until_statement
dispatch_not_until:
addi x7,x0,69
beq x10,x7,end_statement
