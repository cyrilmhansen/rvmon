beq x11,x0,run_line_error
addi x10,x0,3
sd x10,536(x8)
jal x0,run_line
run_command_ten:
addi x10,x0,0
sd x10,536(x8)
jal x0,run_line
; Exécuteur de ligne : trace éventuellement le numéro, positionne x21 sur le
; corps du record et distribue les statements séparés par ':'.
run_line:
jal x0,run_line_generic
run_line_generic:
addi x17,x0,5
ecall
addi x7,x0,3
bne x10,x7,run_line_not_break
jal x0,break_statement
run_line_not_break:
slli x7,x26,3
ld x10,480(x8)
add x10,x10,x7
ld x11,0(x10)
beq x11,x0,run_line_check_direct
slli x7,x26,7
add x24,x19,x7
jal x0,dispatch_statement
run_line_check_direct:
addi x7,x0,1
sll x7,x7,x26
ld x10,512(x8)
and x11,x10,x7
beq x11,x0,run_line_error
slli x7,x26,7
add x24,x19,x7
jal x0,dispatch_statement

run_line_error:
