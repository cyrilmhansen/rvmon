addi x6,x0,79
bne x5,x6,error_line
addi x21,x21,1
addi x22,x0,1
jal x1,parse_atom
ld x31,1560(x8)
fsd f2,8(x31)
addi x6,x0,1
fcvt.d.l f6,x6,0
fsd f6,16(x31)
