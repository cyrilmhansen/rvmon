beq x6,x0,atom_instr_copy_source_done
add x6,x7,x9
lbu x5,0(x6)
add x6,x27,x9
sb x5,0(x6)
addi x9,x9,1
jal x0,atom_instr_copy_source
atom_instr_copy_source_done:
lui x27,0x82060
slli x27,x27,32
srli x27,x27,32
addi x27,x27,1840
sd x27,1944(x8)
lbu x5,0(x21)
addi x6,x0,44
bne x5,x6,atom_function_error
addi x21,x21,1
addi x30,x0,0
jal x1,resolve_string_expression
sd x7,1960(x8)
sd x11,1976(x8)
lbu x5,0(x21)
addi x6,x0,41
bne x5,x6,atom_function_error
addi x21,x21,1
ld x27,1952(x8)
ld x28,1976(x8)
beq x28,x0,atom_instr_empty_needle
sltu x6,x27,x28
bne x6,x0,atom_instr_not_found
sub x29,x27,x28
addi x29,x29,1
addi x9,x0,0
atom_instr_outer:
sltu x6,x9,x29
beq x6,x0,atom_instr_not_found
addi x10,x0,0
