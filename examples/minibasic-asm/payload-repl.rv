jal x0,if_false
while_condition_false:
addi x29,x8,2047
addi x29,x29,1
ld x27,0(x29)
beq x27,x0,while_skip_scan
addi x7,x27,-1
slli x7,x7,3
addi x30,x8,2047
addi x30,x30,9
add x30,x30,x7
ld x31,0(x30)
bne x31,x26,while_skip_scan
addi x27,x27,-1
addi x29,x8,2047
addi x29,x29,1
sd x27,0(x29)
addi x10,x0,3
jal x1,control_pop_expected
while_skip_scan:
addi x27,x0,1
addi x28,x26,1
while_skip_find:
sltiu x7,x28,256
beq x7,x0,error_line_near
slli x7,x28,7
add x31,x19,x7
lbu x5,16(x31)
addi x6,x0,87
bne x5,x6,while_skip_next
lbu x5,17(x31)
addi x6,x0,72
beq x5,x6,while_skip_nested
addi x6,x0,69
bne x5,x6,while_skip_next
lbu x5,18(x31)
addi x6,x0,78
bne x5,x6,while_skip_next
lbu x5,19(x31)
addi x6,x0,68
bne x5,x6,while_skip_next
addi x27,x27,-1
beq x27,x0,while_skip_found
jal x0,while_skip_next
while_skip_nested:
addi x27,x27,1
while_skip_next:
