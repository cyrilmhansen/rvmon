; RUN : initialise le curseur de ligne et le contexte de contrôle, puis
; délègue chaque record à run_line jusqu'à END, erreur ou Ctrl-C.
; RUN choisit le premier record occupé ; run_line charge ensuite le corps,
; gère TRACE et redirige les erreurs avec le numéro de ligne courant.
run_command:
jal x0,run_command_generic
run_command_generic:
sd x0,1616(x8)
sd x0,1704(x8)
sd x0,1712(x8)
addi x29,x8,2047
addi x29,x29,1
sd x0,0(x29)
addi x29,x8,2047
addi x29,x29,81
sd x0,0(x29)
addi x29,x8,2047
addi x29,x29,153
sd x0,0(x29)
addi x26,x0,0
run_find_first_generic:
slli x7,x26,3
ld x10,480(x8)
add x10,x10,x7
ld x11,0(x10)
bne x11,x0,run_first_found_generic
addi x26,x26,1
sltiu x7,x26,256
bne x7,x0,run_find_first_generic
jal x0,error_line
run_first_found_generic:
sd x26,536(x8)
jal x0,run_line

run_command_legacy:
ld x10,512(x8)
andi x11,x10,1
beq x11,x0,run_command_legacy_no_ten
jal x0,run_command_ten
run_command_legacy_no_ten:
andi x11,x10,2
beq x11,x0,run_check_thirty
addi x10,x0,1
sd x10,536(x8)
jal x0,run_line
run_check_thirty:
andi x11,x10,4
beq x11,x0,run_check_forty
