data 0x82000000 .byte 0x52
data 0x82000001 .byte 0x45
data 0x82000002 .byte 0x41
data 0x82000003 .byte 0x44
data 0x82000004 .byte 0x59
data 0x82000005 .byte 0x3e
data 0x82000006 .byte 0x20
data 0x82000010 .byte 0x31
data 0x82000011 .byte 0x30
data 0x82000012 .byte 0x20
data 0x82000020 .byte 0x4e
data 0x82000021 .byte 0x45
data 0x82000022 .byte 0x57
data 0x82000023 .byte 0x20
data 0x82000024 .byte 0x4f
data 0x82000025 .byte 0x4b
data 0x82000026 .byte 0x0a
data 0x82000030 .byte 0x45
data 0x82000031 .byte 0x52
data 0x82000032 .byte 0x52
data 0x82000033 .byte 0x0a
data 0x82000300 .dword 0x4014000000000000
data 0x82000308 .dword 0x4008000000000000
data 0x82000200 .dword 0x0000000000000000
assemble-program 0x81000100
; MiniBASIC-RV payload assembleur : noyau REPL target-side.
; Contrat de cette tranche : une ligne 10 PRINT X+Y, LIST, NEW, RUN.
; Les variables X/Y sont déjà dans la table cible ; le résultat est f3 et RAM.
entry:
auipc x8,0x1000
addi x8,x8,-256
addi x18,x8,1024
addi x19,x8,256
addi x20,x8,768
command_loop:
addi x10,x8,0
addi x11,x0,7
addi x17,x0,4
ecall
addi x9,x0,0
read_line:
addi x17,x0,2
ecall
addi x7,x0,10
beq x10,x7,line_done
add x6,x18,x9
sb x10,0(x6)
addi x9,x9,1
jal x0,read_line
line_done:
lbu x10,0(x18)
addi x7,x0,49
beq x10,x7,store_line
addi x7,x0,76
beq x10,x7,list_line
addi x7,x0,82
beq x10,x7,run_line
addi x7,x0,78
beq x10,x7,new_program
jal x0,error_line
store_line:
lbu x10,1(x18)
addi x7,x0,48
bne x10,x7,error_line
lbu x10,2(x18)
addi x7,x0,32
bne x10,x7,error_line
addi x9,x0,0
copy_body:
lbu x10,3(x18)
add x6,x18,x9
lbu x10,3(x6)
add x6,x19,x9
sb x10,16(x6)
addi x9,x9,1
addi x7,x0,9
bne x9,x7,copy_body
addi x10,x0,1
sd x10,512(x8)
jal x0,command_loop
list_line:
addi x10,x8,16
addi x11,x0,3
addi x17,x0,4
ecall
addi x10,x19,16
addi x11,x0,9
addi x17,x0,4
ecall
addi x10,x8,32
addi x11,x0,1
addi x17,x0,4
ecall
jal x0,command_loop
new_program:
addi x10,x0,0
sd x10,512(x8)
addi x10,x8,32
addi x11,x0,4
addi x17,x0,4
ecall
jal x0,command_loop
run_line:
ld x10,512(x8)
beq x10,x0,error_line
; Facteur gauche : X/Y sont des variables, les chiffres sont des littéraux.
lbu x5,22(x19)
addi x6,x0,88
beq x5,x6,left_x
addi x6,x0,89
beq x5,x6,left_y
sltiu x6,x5,48
bne x6,x0,error_line
sltiu x6,x5,58
beq x6,x0,error_line
addi x6,x0,48
sub x10,x5,x6
fcvt.d.l f1,x10,0
jal x0,right_factor
left_x:
fld f1,0(x20)
jal x0,right_factor
left_y:
fld f1,8(x20)
right_factor:
; Facteur droit : même règle, à l’octet 24 du record.
lbu x5,24(x19)
addi x6,x0,88
beq x5,x6,right_x
addi x6,x0,89
beq x5,x6,right_y
sltiu x6,x5,48
bne x6,x0,error_line
sltiu x6,x5,58
beq x6,x0,error_line
addi x6,x0,48
sub x10,x5,x6
fcvt.d.l f2,x10,0
jal x0,dispatch_operator
right_x:
fld f2,0(x20)
jal x0,dispatch_operator
right_y:
fld f2,8(x20)
; L’opérateur est le huitième octet de PRINT X<op>Y.
dispatch_operator:
lbu x5,23(x19)
addi x6,x0,43
beq x5,x6,run_add
addi x6,x0,45
beq x5,x6,run_sub
addi x6,x0,42
beq x5,x6,run_mul
addi x6,x0,47
beq x5,x6,run_div
jal x0,error_line
run_add:
fadd.d f3,f1,f2
jal x0,run_save
run_sub:
fsub.d f3,f1,f2
jal x0,run_save
run_mul:
fmul.d f3,f1,f2
jal x0,run_save
run_div:
fdiv.d f3,f1,f2
run_save:
fsd f3,1024(x8)
ebreak
error_line:
addi x10,x8,48
addi x11,x0,4
addi x17,x0,4
ecall
jal x0,command_loop
end
symbols
run-at 0x81000100
