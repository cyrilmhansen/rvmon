beq x10,x0,run_line_error
ld x10,536(x8)
beq x10,x0,run_line_ten
addi x7,x0,1
beq x10,x7,run_line_twenty
addi x7,x0,2
beq x10,x7,run_line_thirty
addi x7,x0,3
beq x10,x7,run_line_forty
jal x0,error_line
run_line_twenty:
