sb x7,0(x13)
addi x13,x13,1
addi x10,x8,208
sub x11,x13,x10
addi x17,x0,4
ecall
addi x10,x24,16
slli x7,x26,3
ld x11,480(x8)
add x11,x11,x7
ld x11,0(x11)
addi x17,x0,4
ecall
addi x10,x8,192
addi x11,x0,1
addi x17,x0,4
ecall
list_next_generic:
addi x26,x26,1
sltiu x7,x26,256
bne x7,x0,list_scan_generic
jal x0,command_loop

list_line_legacy:
