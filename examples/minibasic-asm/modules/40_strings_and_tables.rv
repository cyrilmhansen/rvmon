jal x0,next_statement
statement_table_while:
; WHILE garde son analyse de comparaison et sa frame de continuation.
addi x30,x0,1
jal x1,statement_table_fallback
lbu x10,16(x24)
jal x0,while_dispatch
statement_table_wend:
; WEND reprend directement la continuation de la frame WHILE.
addi x30,x0,1
jal x1,statement_table_fallback
lbu x10,16(x24)
jal x0,wend_statement
statement_table_until:
; UNTIL évalue sa condition et dépile/reprend la frame REPEAT côté cible.
addi x30,x0,1
jal x1,statement_table_fallback
jal x0,until_statement
statement_table_repeat:
; REPEAT marque ou réutilise la continuation target-side.
addi x30,x0,1
jal x1,statement_table_fallback
jal x0,repeat_statement
statement_table_do:
; DO pose une frame de contrôle et vérifie la forme V1 sans suffixe.
addi x30,x0,1
jal x1,statement_table_fallback
jal x0,do_statement
statement_table_loop:
; LOOP reprend la continuation de la frame DO target-side.
addi x30,x0,1
jal x1,statement_table_fallback
jal x0,loop_statement
statement_table_miss:
addi x29,x29,1
sltiu x6,x29,25
bne x6,x0,statement_table_next
jal x0,statement_table_fallback
statement_table_fallback:
addi x10,x8,2047
addi x10,x10,513
ld x6,0(x10)
ld x7,8(x10)
ld x9,16(x10)
ld x27,24(x10)
ld x28,32(x10)
ld x29,40(x10)
lbu x10,16(x24)
 bne x30,x0,statement_table_legacy
jal x0,statement_dispatch_legacy
statement_table_legacy:
jalr x0,0(x1)
statement_table_end:
; Veneer local d'ON ; END utilise le fallback legacy sans changement.
jal x0,on_statement
