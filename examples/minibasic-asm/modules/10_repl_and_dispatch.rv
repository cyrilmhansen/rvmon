; ---------------------------------------------------------------------------
; Diagnostics et formatage
; error_line construit le message dans la cible, affiche le numéro de ligne
; et remet l'état d'exécution dans un état sûr avant de revenir au REPL.
; print_result convertit ensuite le résultat binary64 en forme décimale V1.
; ---------------------------------------------------------------------------
error_line:
addi x10,x8,48
addi x11,x0,4
addi x17,x0,4
ecall
jal x0,command_loop
run_save:
ld x24,1864(x8)
addi x27,x8,2047
addi x27,x27,353
fsd f3,0(x27)
sd x21,1176(x8)
lbu x5,0(x21)
addi x7,x0,44
beq x5,x7,print_more_flag
sd x0,568(x8)
jal x0,print_result
print_more_flag:
addi x10,x0,3
sd x10,568(x8)
jal x0,print_result
print_result:
; Publie f3 dans le buffer de sortie, puis choisit la continuation selon le
; contexte : 0 = fin d'expression, 1 = boucle d'émission, 3 = élément après
; une virgule. f3 est restauré après l'ecall car il reste le résultat public
; de l'évaluateur pour l'affectation et le débogueur.
addi x27,x8,2047
addi x27,x27,361
fsd f3,0(x27)
addi x12,x18,32
addi x13,x12,0
fmv.x.d x10,f3
srai x11,x10,63
beq x11,x0,format_positive
addi x6,x0,45
sb x6,0(x13)
addi x13,x13,1
addi x6,x0,1
slli x6,x6,63
xor x10,x10,x6
fmv.d.x f3,x10
format_positive:
addi x14,x13,0
fcvt.l.d x10,f3,1
fcvt.d.l f4,x10,0
fsub.d f5,f3,f4
lui x6,0xf4
addi x6,x6,576
fcvt.d.l f6,x6,0
fmul.d f5,f5,f6
fcvt.l.d x11,f5,1
beq x10,x0,format_zero_integer
format_integer:
addi x6,x0,10
remu x7,x10,x6
addi x7,x7,48
sb x7,0(x13)
addi x13,x13,1
divu x10,x10,x6
bne x10,x0,format_integer
addi x15,x14,0
addi x16,x13,-1
reverse_digits:
sltu x7,x15,x16
beq x7,x0,format_integer_done
lbu x5,0(x15)
lbu x6,0(x16)
sb x6,0(x15)
sb x5,0(x16)
addi x15,x15,1
addi x16,x16,-1
jal x0,reverse_digits
format_zero_integer:
addi x6,x0,48
sb x6,0(x13)
addi x13,x13,1
format_integer_done:
addi x6,x0,46
sb x6,0(x13)
addi x13,x13,1
lui x6,0x18
addi x6,x6,1696
addi x9,x0,6
format_fraction:
divu x7,x11,x6
addi x7,x7,48
sb x7,0(x13)
addi x13,x13,1
remu x11,x11,x6
addi x7,x0,10
divu x6,x6,x7
addi x9,x9,-1
bne x9,x0,format_fraction
addi x6,x0,10
sb x6,0(x13)
addi x13,x13,1
sub x11,x13,x12
addi x10,x12,0
addi x17,x0,4
ecall
addi x27,x8,2047
addi x27,x27,361
fld f3,0(x27)
ld x11,568(x8)
beq x11,x0,print_normal_continuation
sd x0,568(x8)
addi x10,x0,1
beq x11,x10,print_loop_continue
addi x10,x0,3
beq x11,x10,print_more
jal x0,run_stop
print_loop_continue:
ld x10,1248(x8)
addi x26,x10,0
sd x10,536(x8)
jal x0,run_line
print_more:
ld x21,1176(x8)
addi x21,x21,1
addi x10,x0,32
addi x17,x0,1
ecall
print_more_spaces:
lbu x5,0(x21)
addi x7,x0,32
bne x5,x7,print_more_item
addi x21,x21,1
jal x0,print_more_spaces
print_more_item:
; PRINT choisit le type de l'élément en regardant le début du terme. Une
; chaîne est un littéral, un nom en `$` ou une fonction chaîne ; le reste est
; renvoyé à eval_expression. Ce choix évite de confondre le `$` interne de
; ASC/VAL/INSTR avec un séparateur de liste PRINT.
addi x7,x0,34
beq x5,x7,print_more_string
lbu x6,1(x21)
addi x7,x0,36
beq x6,x7,print_more_string_variable
addi x22,x21,0
print_more_string_scan:
lbu x6,0(x22)
addi x7,x0,36
beq x6,x7,print_more_str_long
addi x7,x0,0
beq x6,x7,print_more_numeric
addi x7,x0,44
beq x6,x7,print_more_numeric
addi x22,x22,1
jal x0,print_more_string_scan
print_more_str_long:
lbu x6,1(x22)
addi x7,x0,40
beq x6,x7,print_more_str_array
jal x0,print_more_string_variable
print_more_numeric:
addi x22,x0,0
jal x1,eval_expression
jal x0,run_save
print_more_string:
addi x21,x21,1
jal x0,print_string_loop
print_more_string_variable:
lbu x6,2(x21)
addi x7,x0,40
beq x6,x7,print_more_str_array
jal x1,resolve_string_variable
addi x10,x7,0
addi x17,x0,4
ecall
jal x0,print_string_value_cont
print_more_str_array:
jal x1,resolve_string_array
addi x10,x7,0
addi x17,x0,4
ecall
jal x0,print_string_value_cont
print_normal_continuation:
jal x0,if_false
run_stop:
ebreak
; ---------------------------------------------------------------------------
; ABI interne des valeurs chaîne
; Une routine reçoit x21 au début du terme et rend x7=adresse des octets
; target-side, x11=longueur sans NUL, et x21=caractère suivant le terme.
; Un littéral est copié dans 0x82060100. Un appel qui doit conserver deux
; opérandes copie le premier avant de résoudre le second, car les résolveurs
; partagent sinon leur buffer temporaire.
; ---------------------------------------------------------------------------
; Résolution d'un identifiant target-side.
; Entrée : x21 pointe sur le premier caractère du nom.
; Sorties : x7 pointe sur la valeur binary64, x21 sur le caractère suivant.
; Les noms de 1 caractère restent dans la table A..Z historique ; les autres
; sont conservés dans 32 entrées de 32 octets à data+3000 (nom[16], valeur).
; Résolution des variables numériques : x21 désigne le nom, x7 retourne
; l'adresse de la cellule binary64 et x24 conserve le contexte de l'appel.
; ---------------------------------------------------------------------------
; Résolution des noms et évaluation numérique
; Les identifiants courts sont indexés par leur lettre ; les noms longs sont
; recherchés dans une table compacte par comparaison ASCII insensible à la
; casse. eval_expression est une descente récursive aplatie par niveaux de
; priorité et parse_atom est le point d'entrée des littéraux/fonctions.
; ---------------------------------------------------------------------------
