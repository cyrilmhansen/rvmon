beq x10,x0,after_line_ten
addi x7,x0,1
beq x10,x7,after_line_twenty
addi x7,x0,2
beq x10,x7,after_line_thirty
jal x0,run_stop
after_line_ten:
ld x12,512(x8)
andi x11,x12,2
bne x11,x0,set_next_twenty
andi x11,x12,4
bne x11,x0,set_next_thirty
andi x11,x12,8
bne x11,x0,set_next_forty
jal x0,run_stop
set_next_twenty:
addi x10,x0,1
sd x10,536(x8)
jal x0,run_line
set_next_thirty:
addi x10,x0,2
sd x10,536(x8)
jal x0,run_line
set_next_forty:
addi x10,x0,3
sd x10,536(x8)
jal x0,run_line
after_line_twenty:
