command_loop:
; REPL target-side : affiche READY>, lit une ligne ASCII terminée par LF,
; puis choisit commande directe, record numéroté ou erreur récupérable.
addi x10,x8,0
addi x11,x0,7
addi x17,x0,4
ecall
addi x9,x0,0
read_line:
addi x17,x0,2
ecall
addi x7,x0,10
beq x10,x7,line_done
add x6,x18,x9
sb x10,0(x6)
addi x9,x9,1
jal x0,read_line
line_done:
add x6,x18,x9
sb x0,0(x6)
lbu x10,0(x18)
addi x7,x0,63
beq x10,x7,question_print
addi x7,x0,88
beq x10,x7,assign_x
addi x7,x0,89
beq x10,x7,assign_y
addi x7,x0,68
beq x10,x7,check_d_command
addi x7,x0,65
beq x10,x7,assign_array_direct
addi x7,x0,83
beq x10,x7,string_assign_direct
addi x7,x0,76
beq x10,x7,check_l_command
addi x7,x0,80
beq x10,x7,check_p_command
jal x0,check_generic_assignment
command_number_check:
addi x7,x0,48
sltu x6,x10,x7
bne x6,x0,command_after_number_check
addi x7,x0,58
sltu x6,x10,x7
beq x6,x0,command_after_number_check
jal x0,store_line_generic
command_after_number_check:
addi x7,x0,76
beq x10,x7,check_l_command
addi x7,x0,84
beq x10,x7,trace_command
addi x7,x0,82
beq x10,x7,check_r_command
addi x7,x0,78
bne x10,x7,command_not_new
jal x0,new_program
command_not_new:
command_not_numbered:
jal x0,error_line
check_l_command:
lbu x5,1(x18)
addi x7,x0,73
bne x5,x7,let_direct_command
lbu x5,2(x18)
addi x7,x0,83
bne x5,x7,let_direct_command
lbu x5,3(x18)
addi x7,x0,84
bne x5,x7,let_direct_command
jal x0,list_line
let_direct_command:
lbu x5,1(x18)
addi x7,x0,69
bne x5,x7,long_direct_scan
lbu x5,2(x18)
addi x7,x0,84
bne x5,x7,let_error
lbu x5,3(x18)
addi x7,x0,32
bne x5,x7,let_error
addi x21,x18,4
addi x22,x21,0
let_direct_target_scan:
lbu x5,0(x22)
addi x7,x0,40
beq x5,x7,let_direct_array
addi x7,x0,36
beq x5,x7,let_direct_string
addi x7,x0,61
beq x5,x7,let_direct_scalar
beq x5,x0,let_error
addi x22,x22,1
jal x0,let_direct_target_scan
let_direct_scalar:
jal x1,resolve_variable
sd x7,1112(x8)
lbu x5,0(x21)
addi x7,x0,61
bne x5,x7,let_error
addi x21,x21,1
addi x22,x0,0
jal x1,eval_expression
ld x6,1112(x8)
fsd f3,0(x6)
jal x0,command_loop
long_direct_scan:
addi x22,x18,0
long_direct_target_scan:
lbu x5,0(x22)
addi x7,x0,40
beq x5,x7,array_assign_direct_generic
addi x7,x0,36
beq x5,x7,long_direct_string
addi x7,x0,61
beq x5,x7,check_generic_assignment
beq x5,x0,check_generic_assignment
addi x22,x22,1
jal x0,long_direct_target_scan
long_direct_string:
lbu x5,1(x22)
addi x7,x0,40
beq x5,x7,string_array_assign_direct
jal x0,string_assign_direct
let_direct_array:
jal x1,assign_array
jal x0,command_loop
let_direct_string:
lbu x5,1(x22)
addi x7,x0,40
beq x5,x7,let_direct_string_array
jal x1,string_assign
jal x0,command_loop
let_direct_string_array:
jal x1,string_array_assign
jal x0,command_loop
let_error:
jal x0,error_line_near
early_error:
jal x0,error_line_near
check_p_command:
lbu x5,1(x18)
addi x7,x0,82
beq x5,x7,direct_print
jal x0,check_generic_assignment
check_d_command:
lbu x5,1(x18)
addi x7,x0,73
beq x5,x7,dim_direct
addi x7,x0,69
beq x5,x7,check_del_command
jal x0,check_generic_assignment
check_del_command:
lbu x5,2(x18)
addi x7,x0,76
bne x5,x7,check_generic_assignment
lbu x5,3(x18)
addi x7,x0,32
bne x5,x7,check_generic_assignment
jal x0,delete_range_command
trace_command:
lbu x5,1(x18)
addi x7,x0,82
bne x5,x7,trace_error
lbu x5,2(x18)
addi x7,x0,65
bne x5,x7,trace_error
lbu x5,3(x18)
addi x7,x0,67
bne x5,x7,trace_error
lbu x5,4(x18)
addi x7,x0,69
bne x5,x7,trace_error
lbu x5,5(x18)
addi x7,x0,32
bne x5,x7,trace_error
lbu x5,6(x18)
addi x7,x0,79
beq x5,x7,trace_on
addi x7,x0,79
bne x5,x7,trace_error
trace_on:
lbu x5,7(x18)
addi x7,x0,78
beq x5,x7,trace_enable
lbu x5,7(x18)
addi x7,x0,70
bne x5,x7,trace_error
lbu x5,8(x18)
addi x7,x0,70
bne x5,x7,trace_error
sd x0,544(x8)
jal x0,command_loop
trace_enable:
addi x10,x0,1
sd x10,544(x8)
jal x0,command_loop
trace_error:
jal x0,error_line
check_r_command:
lbu x5,1(x18)
addi x7,x0,69
bne x5,x7,run_command
lbu x5,2(x18)
addi x7,x0,78
bne x5,x7,run_command
lbu x5,3(x18)
addi x7,x0,85
bne x5,x7,run_command
lbu x5,4(x18)
addi x7,x0,77
bne x5,x7,run_command
lbu x5,5(x18)
addi x7,x0,32
bne x5,x7,run_command
jal x0,renum_command
; Compatibilité des anciens labels conservée pour les symboles historiques.
; Magasin de programme : parse le numéro et copie le corps dans un record
; fixe. Le remplacement et la suppression ne déplacent jamais les autres
; records ; LIST les parcourt ensuite par index croissant.
; ---------------------------------------------------------------------------
; Magasin de programme numéroté
; Un record reste à son index (N/10)-1 : aucune compaction n'est nécessaire.
; `store_line_generic` parse le numéro, puis copie le corps ; un numéro seul
; efface la longueur. Cette invariance rend LIST et les sauts déterministes.
; ---------------------------------------------------------------------------
store_line_generic:
; Parse un numéro décimal, puis le convertit en index de ligne (N/10)-1.
; V1 de cette tranche : numéros 10..640 multiples de dix, corps <=111 octets.
addi x6,x0,0
addi x26,x0,0
addi x27,x0,0
store_number_loop:
add x7,x18,x6
lbu x5,0(x7)
addi x7,x0,48
sltu x28,x5,x7
bne x28,x0,store_number_done
addi x7,x0,58
sltu x28,x5,x7
beq x28,x0,store_number_done
addi x7,x0,48
sub x5,x5,x7
addi x7,x0,10
mul x26,x26,x7
add x26,x26,x5
addi x6,x6,1
addi x27,x27,1
jal x0,store_number_loop
store_number_done:
beq x27,x0,store_line_error
addi x7,x0,10
remu x5,x26,x7
bne x5,x0,store_line_error
sltiu x7,x26,10
bne x7,x0,store_line_error
lui x7,1
addi x7,x7,-1535
sltu x7,x26,x7
beq x7,x0,store_line_error
addi x29,x26,0
addi x26,x26,-10
addi x7,x0,10
divu x26,x26,x7
; x26 est maintenant l'index, x24 le record et x25 sa longueur.
slli x7,x26,7
add x24,x19,x7
slli x7,x26,3
ld x25,480(x8)
add x25,x25,x7
add x7,x18,x6
lbu x5,0(x7)
beq x5,x0,delete_line_generic
addi x7,x0,32
bne x5,x7,store_line_error
addi x6,x6,1
sub x28,x9,x6
sltiu x7,x28,112
beq x7,x0,store_line_error
sd x29,0(x24)
sd x0,8(x24)
sd x28,0(x25)
addi x27,x0,0
store_body_generic:
add x7,x18,x6
add x7,x7,x27
lbu x5,0(x7)
addi x7,x24,16
add x7,x7,x27
sb x5,0(x7)
addi x27,x27,1
bne x27,x28,store_body_generic
jal x0,command_loop
delete_line_generic:
sd x0,0(x25)
jal x0,command_loop
store_line_error:
jal x0,error_line

; DEL start[,end] : suppression target-side d'un intervalle inclusif de lignes.
; Les numéros suivent la même politique que le magasin : 10..2560, pas de dix.
; DEL : prévalide les deux bornes avant d'effacer la table des longueurs.
; L'effacement est donc atomique du point de vue du programme utilisateur.
delete_range_command:
addi x21,x18,4
addi x26,x0,0
addi x27,x0,0
delete_range_start_digits:
lbu x5,0(x21)
addi x7,x0,48
sltu x28,x5,x7
bne x28,x0,delete_range_start_done
addi x7,x0,58
sltu x28,x5,x7
beq x28,x0,delete_range_start_done
addi x7,x0,48
sub x5,x5,x7
addi x7,x0,10
mul x26,x26,x7
add x26,x26,x5
addi x27,x27,1
addi x21,x21,1
jal x0,delete_range_start_digits
delete_range_start_done:
beq x27,x0,delete_range_error
addi x28,x5,0
addi x7,x0,10
remu x5,x26,x7
bne x5,x0,delete_range_error
sltiu x7,x26,10
bne x7,x0,delete_range_error
lui x7,1
addi x7,x7,-1535
sltu x7,x26,x7
beq x7,x0,delete_range_error
addi x7,x0,44
bne x28,x7,delete_range_single
addi x21,x21,1
addi x27,x0,0
delete_range_end_digits:
lbu x5,0(x21)
addi x7,x0,48
sltu x28,x5,x7
bne x28,x0,delete_range_end_done
addi x7,x0,58
sltu x28,x5,x7
beq x28,x0,delete_range_end_done
addi x7,x0,48
sub x5,x5,x7
addi x7,x0,10
mul x27,x27,x7
add x27,x27,x5
addi x21,x21,1
jal x0,delete_range_end_digits
delete_range_end_done:
beq x27,x0,delete_range_error
addi x7,x0,10
remu x5,x27,x7
bne x5,x0,delete_range_error
sltiu x7,x27,10
bne x7,x0,delete_range_error
lui x7,1
addi x7,x7,-1535
sltu x7,x27,x7
beq x7,x0,delete_range_error
jal x0,delete_range_indexes
delete_range_single:
addi x27,x26,0
delete_range_indexes:
addi x7,x26,0
addi x26,x26,-10
addi x6,x0,10
divu x26,x26,x6
addi x27,x27,-10
divu x27,x27,x6
sltu x7,x27,x26
bne x7,x0,delete_range_error
delete_range_loop:
slli x7,x26,3
ld x10,480(x8)
add x10,x10,x7
sd x0,0(x10)
beq x26,x27,delete_range_done
addi x26,x26,1
jal x0,delete_range_loop
delete_range_done:
jal x0,command_loop
delete_range_error:
jal x0,error_line

; RENUM new_start,old_start,step.
; Les records restent dans leur slot physique ; leur numéro courant est écrit
; en +0 et l'ancien en +8. Deux passes valident puis renumérotent les records.
; renum_rewrite_all réécrit ensuite les cibles numériques dans le scratch cible,
; ce qui rend les références GOTO/GOSUB/THEN/ON robustes après plusieurs RENUM.
renum_command:
addi x6,x8,2040
addi x6,x6,416
sd x0,0(x6)
addi x21,x18,6
addi x26,x0,0
addi x27,x0,0
addi x28,x0,0
addi x29,x0,0
renum_new_digits:
lbu x5,0(x21)
addi x7,x0,48
sltu x6,x5,x7
bne x6,x0,renum_new_done
addi x7,x0,58
sltu x6,x5,x7
beq x6,x0,renum_new_done
addi x7,x0,48
sub x5,x5,x7
addi x7,x0,10
mul x26,x26,x7
add x26,x26,x5
addi x29,x29,1
addi x21,x21,1
jal x0,renum_new_digits
renum_new_done:
beq x29,x0,renum_error
addi x7,x0,44
bne x5,x7,renum_error
addi x7,x0,10
remu x5,x26,x7
bne x5,x0,renum_error
sltiu x7,x26,10
bne x7,x0,renum_error
lui x7,1
addi x7,x7,-1535
sltu x7,x26,x7
beq x7,x0,renum_error
addi x21,x21,1
addi x29,x0,0
renum_old_digits:
lbu x5,0(x21)
addi x7,x0,48
sltu x6,x5,x7
bne x6,x0,renum_old_done
addi x7,x0,58
sltu x6,x5,x7
beq x6,x0,renum_old_done
addi x7,x0,48
sub x5,x5,x7
addi x7,x0,10
mul x27,x27,x7
add x27,x27,x5
addi x29,x29,1
addi x21,x21,1
jal x0,renum_old_digits
renum_old_done:
beq x29,x0,renum_error
addi x7,x0,44
bne x5,x7,renum_error
addi x7,x0,10
remu x5,x27,x7
bne x5,x0,renum_error
sltiu x7,x27,10
bne x7,x0,renum_error
lui x7,1
addi x7,x7,-1535
sltu x7,x27,x7
beq x7,x0,renum_error
addi x21,x21,1
addi x29,x0,0
renum_step_digits:
lbu x5,0(x21)
addi x7,x0,48
sltu x6,x5,x7
bne x6,x0,renum_step_done
addi x7,x0,58
sltu x6,x5,x7
beq x6,x0,renum_step_done
addi x7,x0,48
sub x5,x5,x7
addi x7,x0,10
mul x28,x28,x7
add x28,x28,x5
addi x29,x29,1
addi x21,x21,1
jal x0,renum_step_digits
renum_step_done:
beq x29,x0,renum_error
bne x5,x0,renum_error
addi x7,x0,10
remu x5,x28,x7
bne x5,x0,renum_error
sltiu x7,x28,10
bne x7,x0,renum_error
lui x7,1
addi x7,x7,-1535
sltu x7,x28,x7
beq x7,x0,renum_error
sltu x7,x26,x27
bne x7,x0,renum_error
; Conserver les numéros actuels hors des records : en cas de dépassement du
; scratch de réécriture, RENUM pourra restaurer exactement l'état précédent.
lui x22,0x82061
slli x22,x22,32
srli x22,x22,32
addi x22,x22,-512
addi x30,x0,0
renum_snapshot_numbers:
sltiu x7,x30,256
beq x7,x0,renum_snapshot_done
slli x7,x30,7
add x24,x19,x7
ld x6,0(x24)
sd x6,0(x22)
addi x22,x22,8
addi x30,x30,1
jal x0,renum_snapshot_numbers
renum_snapshot_done:
; Les records ne changent pas de slot physique après RENUM. Le parcours doit
; inspecter le numéro courant du record, et non indexer line_lengths avec
; old_start ; cette distinction rend les RENUM successifs possibles.
addi x30,x0,0
addi x31,x26,0
addi x22,x0,0
renum_preflight_line:
sltiu x7,x30,256
beq x7,x0,renum_preflight_done
slli x7,x30,7
add x24,x19,x7
ld x6,0(x24)
beq x6,x0,renum_preflight_empty
sltu x7,x6,x27
bne x7,x0,renum_preflight_empty
lui x7,1
addi x7,x7,-1535
sltu x7,x31,x7
beq x7,x0,renum_error
addi x22,x0,1
; La prévalidation vérifie uniquement les bornes et la présence d'au moins
; une ligne. Les cibles textuelles sont résolues par alias au moment du RUN.
jal x0,renum_preflight_next
renum_preflight_next:
addi x30,x30,1
add x31,x31,x28
jal x0,renum_preflight_line
renum_preflight_empty:
addi x30,x30,1
jal x0,renum_preflight_line
renum_preflight_done:
beq x22,x0,renum_error
addi x30,x0,0
addi x31,x26,0
renum_write_line:
sltiu x7,x30,256
beq x7,x0,renum_done
slli x7,x30,7
add x24,x19,x7
ld x6,0(x24)
beq x6,x0,renum_write_empty
sltu x7,x6,x27
bne x7,x0,renum_write_empty
sd x6,8(x24)
sd x31,0(x24)
add x31,x31,x28
renum_write_empty:
addi x30,x30,1
jal x0,renum_write_line
renum_done:
addi x6,x8,2040
addi x6,x6,416
addi x7,x0,1
sd x7,0(x6)
; Le texte des sauts reste dans les records ; réécrire ces numéros après la
; seconde passe évite de dépendre d'un alias unique lors d'un RENUM ultérieur.
jal x0,renum_rewrite_all
renum_error:
addi x7,x8,2040
addi x7,x7,416
ld x6,0(x7)
bne x6,x0,renum_rollback_numbers
jal x0,error_line

; La réécriture de texte est prévalidée avant toute publication. Si elle
; dépasse 111 octets, restaurer les numéros depuis la copie de transaction et
; laisser les corps de lignes intacts.
renum_rollback_numbers:
lui x22,0x82061
slli x22,x22,32
srli x22,x22,32
addi x22,x22,-512
addi x30,x0,0
renum_rollback_loop:
sltiu x7,x30,256
beq x7,x0,renum_rollback_done
slli x7,x30,7
add x24,x19,x7
ld x6,0(x22)
sd x6,0(x24)
addi x22,x22,8
addi x30,x30,1
jal x0,renum_rollback_loop
renum_rollback_done:
addi x6,x8,2040
addi x6,x6,416
sd x0,0(x6)
addi x18,x8,1024
jal x0,error_line

; Réécriture target-side des cibles GOTO/GOSUB/THEN/ON après RENUM.
; x23=slot, x24=record, x25=longueur, x26=curseur source, x27=sortie,
; x29=état (bit0 guillemets, bit1 prochain nombre cible, bit2 ON), x22=scratch.
; Les mots-clés sont reconnus hors chaînes ; les nombres sont résolus par
; record+0/record+8 et émis en décimal dans un scratch avant publication.
renum_rewrite_all:
lui x22,0x82061
slli x22,x22,32
srli x22,x22,32
addi x22,x22,-1024
addi x23,x0,0
; x18=1 signifie prévalidation : le scratch est rempli et mesuré, mais jamais
; copié dans le record. La seconde passe remet x18 à zéro pour publier.
addi x18,x0,1
renum_rewrite_record:
sltiu x7,x23,256
beq x7,x0,renum_rewrite_done
slli x7,x23,7
add x24,x19,x7
slli x7,x23,3
ld x6,480(x8)
add x6,x6,x7
ld x25,0(x6)
beq x25,x0,renum_rewrite_skip_record
addi x26,x0,0
addi x27,x0,0
addi x29,x0,0
renum_rewrite_scan:
sltu x7,x26,x25
beq x7,x0,renum_rewrite_publish
addi x7,x24,16
add x7,x7,x26
lbu x5,0(x7)
addi x6,x0,34
beq x5,x6,renum_rewrite_quote
andi x6,x29,1
bne x6,x0,renum_rewrite_copy
addi x6,x0,58
beq x5,x6,renum_rewrite_colon
andi x6,x29,2
bne x6,x0,renum_rewrite_target
jal x0,renum_rewrite_keyword
renum_rewrite_quote:
xori x29,x29,1
jal x0,renum_rewrite_copy
renum_rewrite_colon:
addi x29,x0,0
jal x0,renum_rewrite_copy
renum_rewrite_target:
addi x6,x0,48
sltu x7,x5,x6
bne x7,x0,renum_rewrite_target_done
addi x6,x0,58
sltu x7,x5,x6
beq x7,x0,renum_rewrite_target_done
addi x28,x0,0
addi x31,x0,0
renum_rw_digits:
