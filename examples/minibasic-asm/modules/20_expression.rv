lui x6,0x82062
slli x6,x6,32
srli x6,x6,32
addi x6,x6,1856
ld x5,0(x6)
bne x5,x0,integrated_token_no
sltiu x6,x11,32
beq x6,x0,integrated_token_error
jal x1,integrated_operator_push_open
addi x9,x9,1
jal x0,integrated_token_loop
integrated_token_close:
bne x24,x0,integrated_token_error
addi x9,x9,1
integrated_token_close_reduce:
beq x11,x0,integrated_token_error
lui x27,0x82062
slli x27,x27,32
srli x27,x27,32
addi x27,x27,1792
add x6,x27,x11
addi x6,x6,-1
lbu x5,0(x6)
