lui x7,0x82062
slli x7,x7,32
srli x7,x7,32
addi x7,x7,768
addi x10,x7,-32
ld x11,0(x10)
bne x11,x0,expression_lexer_skip
addi x11,x0,1
sd x11,0(x10)
addi x10,x7,-16
sd x0,0(x10)
addi x6,x21,0
addi x9,x0,0
addi x29,x0,0
addi x28,x0,0
