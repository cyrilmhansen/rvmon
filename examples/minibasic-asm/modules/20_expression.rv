jal x1,integrated_value_push
jal x0,integrated_token_loop
integrated_token_operator:
ld x6,8(x28)
lbu x5,0(x6)
addi x14,x5,0
addi x9,x9,1
beq x24,x0,itok_binary_op
addi x6,x0,43
beq x5,x6,integrated_token_unary_plus
addi x6,x0,45
bne x5,x6,integrated_token_error
lui x6,0x82062
slli x6,x6,32
srli x6,x6,32
addi x6,x6,1856
ld x5,0(x6)
addi x5,x5,1
andi x5,x5,1
sd x5,0(x6)
