; Tokenized expression bridge. This is deliberately a subset gate: only a
; complete number/operator/parenthesis stream enters the new evaluator. Names,
; function calls, strings, commas and unary operators return x6=0 and retain
; the historical cursor parser. The gate is what makes the migration safe:
; the token lexer is shared, but unsupported grammar is never half-consumed.
integrated_token_try:
lui x7,0x82062
slli x7,x7,32
srli x7,x7,32
addi x7,x7,768
; x18 is the persistent input-buffer pointer. The numeric reader uses it as
; a digit counter, so preserve it across the target-side evaluator.
lui x10,0x82062
slli x10,x10,32
srli x10,x10,32
addi x10,x10,1832
sd x18,0(x10)
; integrated_token_eval uses x31 as its own continuation. Preserve the
; caller's eval_expression return address across that nested evaluator.
addi x10,x10,8
sd x31,0(x10)
addi x10,x7,-16
ld x9,0(x10)
beq x9,x0,integrated_token_no
addi x29,x0,0
addi x30,x0,1
addi x27,x0,0
integrated_token_validate_loop:
sltu x6,x29,x9
beq x6,x0,integrated_token_validate_done
slli x6,x29,4
slli x10,x29,3
add x28,x6,x10
add x28,x7,x28
ld x5,0(x28)
addi x6,x0,1
beq x5,x6,itok_val_num
addi x6,x0,3
beq x5,x6,itok_val_op
addi x6,x0,4
beq x5,x6,integrated_token_validate_open
addi x6,x0,5
beq x5,x6,integrated_token_validate_close
jal x0,integrated_token_no
itok_val_num:
beq x30,x0,integrated_token_no
addi x30,x0,0
addi x29,x29,1
jal x0,integrated_token_validate_loop
itok_val_op:
beq x30,x0,itok_val_opbyte
ld x6,8(x28)
lbu x5,0(x6)
addi x6,x0,43
beq x5,x6,integrated_token_operator_ok
addi x6,x0,45
beq x5,x6,integrated_token_operator_ok
jal x0,integrated_token_no
itok_val_opbyte:
ld x6,8(x28)
lbu x5,0(x6)
addi x6,x0,43
beq x5,x6,integrated_token_operator_ok
addi x6,x0,45
beq x5,x6,integrated_token_operator_ok
addi x6,x0,42
beq x5,x6,integrated_token_operator_ok
addi x6,x0,47
bne x5,x6,integrated_token_no
integrated_token_operator_ok:
addi x30,x0,1
addi x29,x29,1
jal x0,integrated_token_validate_loop
integrated_token_validate_open:
beq x30,x0,integrated_token_no
addi x6,x27,1
sltiu x10,x6,32
beq x10,x0,integrated_token_no
addi x27,x6,0
addi x29,x29,1
jal x0,integrated_token_validate_loop
integrated_token_validate_close:
bne x30,x0,integrated_token_no
beq x27,x0,integrated_token_no
addi x27,x27,-1
addi x30,x0,0
addi x29,x29,1
jal x0,integrated_token_validate_loop
integrated_token_validate_done:
bne x30,x0,integrated_token_no
bne x27,x0,integrated_token_no
jal x1,integrated_token_eval
; Restore the REPL input-buffer pointer before returning to PRINT or the
; command loop. The evaluator is otherwise free to use x18 as scratch.
lui x10,0x82062
slli x10,x10,32
srli x10,x10,32
addi x10,x10,1832
ld x18,0(x10)
fmv.x.d x10,f1
fmv.d.x f3,x10
; The evaluator reuses x7 for record and stack addresses; rebuild the token
; base before advancing the historical source cursor.
lui x7,0x82062
slli x7,x7,32
srli x7,x7,32
addi x7,x7,768
addi x29,x9,-1
slli x6,x29,4
slli x10,x29,3
add x28,x6,x10
add x28,x7,x28
ld x21,8(x28)
ld x6,16(x28)
add x21,x21,x6
; x9 is the source length used by the direct/program PRINT dispatcher.
lui x10,0x82062
slli x10,x10,32
srli x10,x10,32
addi x10,x10,1848
ld x9,0(x10)
; Audit marker: this expression completed through the token evaluator. It is
; target memory, not host output, and is cleared by NEW in a later tranche.
lui x10,0x82062
slli x10,x10,32
srli x10,x10,32
addi x10,x10,1824
addi x6,x0,1
sd x6,0(x10)
addi x10,x10,16
ld x31,0(x10)
addi x6,x0,1
jalr x0,0(x1)
integrated_token_no:
; x7 is the token-stream base, so use absolute global cells here.
lui x10,0x82062
slli x10,x10,32
srli x10,x10,32
addi x10,x10,1840
ld x31,0(x10)
addi x10,x10,-8
ld x18,0(x10)
addi x10,x10,16
ld x9,0(x10)
addi x6,x0,0
jalr x0,0(x1)

; The following evaluator is target-side and uses a 32-value/32-operator
; static stack at 0x82062600. It mirrors the TBXL EXEXPR separation: token
; reading, precedence reduction and operation execution are independent.
integrated_token_eval:
addi x31,x1,0
addi x9,x0,0
addi x10,x0,0
addi x11,x0,0
addi x24,x0,1
lui x6,0x82062
slli x6,x6,32
srli x6,x6,32
addi x6,x6,1856
