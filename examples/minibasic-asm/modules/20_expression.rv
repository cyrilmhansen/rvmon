addi x10,x0,34
beq x5,x10,expression_lexer_string
addi x10,x5,-48
sltiu x10,x10,10
bne x10,x0,expression_lexer_number
addi x10,x0,46
beq x5,x10,expression_lexer_number
addi x10,x5,-97
sltiu x10,x10,26
bne x10,x0,expression_lexer_name
addi x10,x5,-65
sltiu x10,x10,26
bne x10,x0,expression_lexer_name
addi x10,x0,43
beq x5,x10,expression_lexer_operator
addi x10,x0,45
beq x5,x10,expression_lexer_operator
addi x10,x0,42
beq x5,x10,expression_lexer_operator
addi x10,x0,47
