; Affectation chaîne : le dispatcher distingue variable scalaire, élément de
; tableau et terme composé. Les routines ci-dessous évaluent d'abord le RHS
; dans un scratch target-side, puis copient vers la destination seulement
; après validation : une erreur ne laisse donc pas une chaîne partiellement
; écrite. x7/x11 forment le couple adresse/longueur d'une source résolue.
; Affectation chaîne : stocke longueur + octets, puis traite les formes
; littérale, variable, concaténation et fonctions de découpe sans allocation
; hôte. Les helpers utilisent les buffers temporaires de MEMORY_MAP.md.
string_assign:
sd x1,1152(x8)
jal x1,resolve_string_variable
ld x1,1152(x8)
addi x27,x7,0
sd x27,1976(x8)
lbu x5,0(x21)
addi x6,x0,61
bne x5,x6,string_long_error
addi x21,x21,1
sd x21,2040(x8)
lbu x5,0(x21)
addi x6,x0,34
beq x5,x6,string_literal_open_save
addi x6,x0,76
sd x21,1992(x8)
beq x5,x6,string_assign_check_left
addi x6,x0,82
sd x21,1992(x8)
beq x5,x6,string_assign_check_right
addi x6,x0,77
sd x21,1992(x8)
bne x5,x6,string_assign_concat
jal x0,string_assign_check_mid
string_assign_concat:
; Retour externe du wrapper : séparé des cadres de termes qui utilisent x8+2000.
lui x27,0x82060
slli x27,x27,32
srli x27,x27,32
addi x27,x27,1792
sd x1,0(x27)
jal x1,string_concat_assign
lui x27,0x82060
slli x27,x27,32
srli x27,x27,32
addi x27,x27,1792
ld x1,0(x27)
jalr x0,0(x1)
string_assign_left:
 lui x27,0x82060
slli x27,x27,32
srli x27,x27,32
addi x27,x27,1832
sd x1,0(x27)
jal x1,string_left_assign
 lui x27,0x82060
slli x27,x27,32
srli x27,x27,32
addi x27,x27,1832
ld x1,0(x27)
jalr x0,0(x1)
string_assign_right:
 lui x27,0x82060
slli x27,x27,32
srli x27,x27,32
addi x27,x27,1832
sd x1,0(x27)
jal x1,string_right_assign
 lui x27,0x82060
slli x27,x27,32
srli x27,x27,32
addi x27,x27,1832
ld x1,0(x27)
jalr x0,0(x1)
