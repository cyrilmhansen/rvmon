jal x0,string_literal_open
string_literal_open:
addi x21,x21,1
addi x9,x0,0
string_copy:
lbu x5,0(x21)
addi x6,x0,34
beq x5,x6,string_done
addi x6,x0,120
sltu x7,x9,x6
beq x7,x0,string_long_error
add x6,x27,x9
sb x5,0(x6)
addi x9,x9,1
addi x21,x21,1
jal x0,string_copy
string_done:
addi x6,x27,-8
sd x9,0(x6)
 lbu x5,1(x21)
addi x6,x0,43
bne x5,x6,string_done_return
