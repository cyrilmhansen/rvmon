; Niveau somme : le terme de gauche est déjà dans f1.
first_two:
fld f1,16(x8)
jal x0,parse_add
first_three:
fld f1,24(x8)
jal x0,parse_add
first_four:
fld f1,32(x8)
parse_add:
lbu x5,1(x8)
addi x6,x0,43
bne x5,x6,fail
lbu x5,2(x8)
addi x6,x0,51
beq x5,x6,second_three
addi x6,x0,52
beq x5,x6,second_four
jal x0,fail
