info payload
assemble-program 0x81000100
; Deux tours UART, insertion ordonnée et records conservés en RAM cible.
entry:
auipc x8,0x1000
addi x8,x8,-256
addi x6,x8,256
addi x18,x8,512
addi x25,x0,0
read_line:
addi x9,x0,0
read_char_loop:
addi x17,x0,2
ecall
addi x7,x0,10
beq x10,x7,parse_line
add x7,x18,x9
sb x10,0(x7)
addi x9,x9,1
jal x0,read_char_loop
parse_line:
addi x19,x0,0
addi x10,x0,0
line_digits:
add x7,x18,x19
lbu x14,0(x7)
addi x15,x0,32
beq x14,x15,line_separator
addi x15,x0,48
sub x14,x14,x15
sltiu x15,x14,10
beq x15,x0,fail
slli x7,x10,3
slli x11,x10,1
add x10,x7,x11
add x10,x10,x14
addi x19,x19,1
jal x0,line_digits
line_separator:
addi x19,x19,1
addi x11,x0,0
add x7,x18,x19
body_length:
lbu x14,0(x7)
beq x14,x0,body_length_done
addi x7,x7,1
addi x11,x11,1
jal x0,body_length
body_length_done:
beq x25,x0,first_slot
ld x13,0(x6)
slt x15,x10,x13
bne x15,x0,insert_before
; Le candidat est après le premier record.
addi x7,x6,32
sd x10,0(x7)
sd x11,8(x7)
addi x14,x7,16
add x15,x18,x19
addi x22,x0,0
copy_after:
beq x22,x11,insert_done
lbu x23,0(x15)
sb x23,0(x14)
addi x15,x15,1
addi x14,x14,1
addi x22,x22,1
jal x0,copy_after
insert_before:
; Déplacer le premier record complet vers le second slot.
ld x13,0(x6)
sd x13,32(x6)
ld x13,8(x6)
sd x13,40(x6)
addi x14,x6,16
addi x15,x6,48
addi x22,x0,0
move_old:
beq x22,x13,write_first
lbu x23,0(x14)
sb x23,0(x15)
addi x14,x14,1
addi x15,x15,1
addi x22,x22,1
jal x0,move_old
write_first:
sd x10,0(x6)
sd x11,8(x6)
addi x14,x6,16
add x15,x18,x19
addi x22,x0,0
copy_first:
beq x22,x11,insert_done
lbu x23,0(x15)
sb x23,0(x14)
addi x15,x15,1
addi x14,x14,1
addi x22,x22,1
jal x0,copy_first
first_slot:
sd x10,0(x6)
sd x11,8(x6)
addi x14,x6,16
add x15,x18,x19
addi x22,x0,0
copy_only:
beq x22,x11,insert_done
lbu x23,0(x15)
sb x23,0(x14)
addi x15,x15,1
addi x14,x14,1
addi x22,x22,1
jal x0,copy_only
insert_done:
addi x25,x25,1
addi x15,x25,-2
bne x15,x0,read_line
sd x25,512(x8)
ebreak
fail:
addi x10,x0,1
addi x17,x0,3
ecall
end
symbols
run-at 0x81000100
regs
memory 0x82000100 64
memory 0x82000200 8
q
