info payload
; L’expression cible est volontairement courte : 12+3*4.
data 0x82000000 .byte 0x31
data 0x82000001 .byte 0x32
data 0x82000002 .byte 0x2b
data 0x82000003 .byte 0x33
data 0x82000004 .byte 0x2a
data 0x82000005 .byte 0x34
assemble-program 0x81000100
; x8 = base de l’expression, x9 = index, x10 = accumulateur entier.
entry:
auipc x8,0x1000
addi x8,x8,-256
addi x9,x0,0
addi x10,x0,0
; Accumulation base 10 : valeur = valeur * 10 + chiffre.
left_digits:
add x6,x8,x9
lbu x5,0(x6)
addi x6,x0,43
beq x5,x6,left_end
addi x6,x0,48
sub x5,x5,x6
sltiu x6,x5,10
beq x6,x0,fail
slli x7,x10,3
slli x11,x10,1
add x10,x7,x11
add x10,x10,x5
addi x9,x9,1
jal x0,left_digits
left_end:
; Le premier nombre devient le registre flottant f1.
fcvt.d.l f1,x10,0
addi x9,x9,1
addi x10,x0,0
; Le même lexer minimal lit l’opérande placé entre + et *.
middle_digits:
add x6,x8,x9
lbu x5,0(x6)
addi x6,x0,42
beq x5,x6,middle_end
addi x6,x0,48
sub x5,x5,x6
sltiu x6,x5,10
beq x6,x0,fail
slli x7,x10,3
slli x11,x10,1
add x10,x7,x11
add x10,x10,x5
addi x9,x9,1
jal x0,middle_digits
middle_end:
; f2 et f3 sont ensuite multipliés avant l’addition à f1.
fcvt.d.l f2,x10,0
addi x9,x9,1
addi x10,x0,0
right_digits:
add x6,x8,x9
lbu x5,0(x6)
beq x5,x0,right_end
addi x6,x0,48
sub x5,x5,x6
sltiu x6,x5,10
beq x6,x0,fail
slli x7,x10,3
slli x11,x10,1
add x10,x7,x11
add x10,x10,x5
addi x9,x9,1
jal x0,right_digits
right_end:
fcvt.d.l f3,x10,0
fmul.d f4,f2,f3
fadd.d f5,f1,f4
fsd f5,32(x8)
ebreak
; Un caractère qui n’est ni opérateur ni chiffre est rejeté dans la cible.
fail:
addi x10,x0,1
addi x17,x0,3
ecall
end
symbols
run-at 0x81000100
regs
memory 0x82000020 8
q
